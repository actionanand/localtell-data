{
  "name": "local-tell",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "develop": "ng serve --port 3041",
    "build": "ng build",
    "build:gh": "node scripts/build-gh.mjs",
    "mirror:data": "node scripts/mirror-release-data.mjs dist/local-tell/browser/data-mirror",
    "watch": "ng build --watch --configuration development",
    "copy-error-page": "node scripts/copy-error-page.mjs",
    "test": "ng test",
    "test:ci": "ng test --watch=false && node --test \"scripts/*.test.mjs\"",
    "e2e": "playwright test",
    "serve:dist": "node scripts/serve-dist.mjs",
    "precommit:dummy": "echo 'This is a dummy print message!'",
    "precommit": "run-s format:fix lint",
    "format:fix": "pretty-quick --staged",
    "format:check": "prettier --config ./.prettierrc --list-different \"src/{app,environments,assets}/**/*{.ts,.js,.json,.css,.scss}\"",
    "format:all": "prettier --config ./.prettierrc --write \"src/{app,environments,assets}/**/*{.ts,.js,.json,.css,.scss}\"",
    "lint": "ng lint",
    "prepare": "husky"
  },
  "private": true,
  "packageManager": "npm@11.13.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/service-worker": "~22.1.5",
    "dropbox": "^10.47.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "sql.js": "^1.15.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/leaflet": "^1.9.22",
    "@types/sql.js": "^1.4.11",
    "angular-eslint": "22.1.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.3.0",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.3",
    "pretty-quick": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.60.1",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.22.3 || >=24.15.0 || >=26.0.0"
  }
}
